<Project Sdk="Microsoft.NET.Sdk">
  <!-- Verifies that every type/member the plugin references exists in a given set of reference assemblies
       (e.g. a different BepInEx or Unity version). Usage: RefCheck plugin.dll refdir [refdir ...] -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="0.11.5" />
  </ItemGroup>
</Project>
