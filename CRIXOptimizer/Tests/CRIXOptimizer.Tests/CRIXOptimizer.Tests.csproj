<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Test suite. Built as a netstandard2.1 library (same target as the plugin) and executed by Tests/Runner
    on Mono, the runtime family Unity uses, with the same HarmonyX build BepInEx 5 ships.
    Run everything with: Tests/run-tests.sh
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>CRIXOptimizer.Tests</AssemblyName>
    <RootNamespace>CRIXOptimizer.Tests</RootNamespace>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../CRIXOptimizer.csproj" />
    <ProjectReference Include="../FakeGame/FakeGame.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExRefPath)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExRefPath)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(UnityRefPath)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
